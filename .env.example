# PWA-TorServe Environment Configuration
# Copy this file to .env and adjust values as needed

# Path where torrents will be downloaded
# Docker: /app/downloads (mapped to ./downloads on host)
# Termux: ~/tor-cache (mounted NAS)
DOWNLOAD_PATH=/app/downloads

# Server port (default: 3000)
PORT=3000

# Fixed torrent listen port for inbound peers and shared DHT
TORRENT_PORT=6881

# Node.js environment
NODE_ENV=production

# API Keys (Get from: themoviedb.org / kinopoiskapiunofficial.tech)
TMDB_API_KEY=
KP_API_KEY=

# TMDB Proxy URL (optional - your Cloudflare Worker for bypassing ISP blocks)
# Example: https://your-worker.workers.dev
TMDB_PROXY_URL=

# Client build keys (VITE_TMDB_API_KEY, VITE_KP_API_KEY, VITE_TMDB_PROXY_URL)
# are NOT read from this file: Vite loads them from client/.env at build time
# and compiles them into the bundle. Never publish a build that contains them.

# ── TorrServer sidecar (see README) ──────────────────────────────
# TS_FAILOVER=0                       # disable handover to TorrServer
# TS_URL=http://172.17.0.1:8090       # how this server reaches TorrServer
# TS_PUBLIC_PORT=8090                 # TorrServer port the player is sent to
# TS_BOOST_MAX_SPEED_BPS=5242880      # hide/refuse manual boost above 5 MB/s

# ── Built-in engine ──────────────────────────────────────────────
# TORRENT_CONNECTIONS=55
# TORRENT_MAX_PENDING_WRITE_MB=64     # pieces queued for disk before requests pause

# ── Trakt (developer.trakt.tv → create app; no secret for new apps) ──
# TRAKT_CLIENT_ID=
# TRAKT_REDIRECT_URI=https://example.com/registered-redirect

# ── Optional search providers ────────────────────────────────────
# RUTRACKER_LOGIN=
# RUTRACKER_PASSWORD=
# TORLOOK_ENABLED=1
# TORZNAB_ENABLED=1
# TORZNAB_URL=http://jackett:9117/api/v2.0/indexers/all/results/torznab/
# TORZNAB_API_KEY=
